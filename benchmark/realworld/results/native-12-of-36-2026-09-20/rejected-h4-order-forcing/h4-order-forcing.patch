+#[test]
+fn h4_known_runs_align_around_unknown_page() -> Result<()> {
+    let mut diagnostics = PipelineDiagnostics::new();
+    let (outcome, alignment) = compare_extraction_outcomes_with_alignment_diagnostics(
+        ExtractionOutcome::complete(h4_document(false)),
+        ExtractionOutcome::complete(h4_document(true)),
+        PipelineOptions::default(),
+        &mut diagnostics,
+    )?;
+    if let Some(alignment) = &alignment {
+        for span in &alignment.spans {
+            println!(
+                "H4 span kind={:?} old={:?} new={:?} evidence={:?}",
+                span.kind, span.old, span.new, span.evidence
+            );
+        }
+    }
+    for record in diagnostics.records() {
+        let metrics = &record.metrics;
+        if metrics.indexed_features.is_some()
+            || metrics.candidate_visits.is_some()
+            || metrics.alignment_spans.is_some()
+            || metrics.uncertain_lines_unproven_inter_region_order.is_some()
+            || metrics.uncertain_lines_untrusted_in_known_order.is_some()
+            || metrics.inferred_reading_order_lines.is_some()
+        {
+            println!(
+                "H4 phase={:?} side={:?} inter={:?} untrusted={:?} inferred={:?} indexed={:?} visits={:?} spans={:?}",
+                record.phase,
+                record.side,
+                metrics.uncertain_lines_unproven_inter_region_order,
+                metrics.uncertain_lines_untrusted_in_known_order,
+                metrics.inferred_reading_order_lines,
+                metrics.indexed_features,
+                metrics.candidate_visits,
+                metrics.alignment_spans
+            );
+        }
+    }
+    let comparison = &outcome.comparison;
+    let summary = summarize(comparison, &outcome.extraction)?;
+    println!(
+        "H4 complete={} changes={} unresolved={} candidates={} old_cov={:?} new_cov={:?}",
+        summary.comparison_complete,
+        comparison.changes.len(),
+        comparison.unresolved_regions.len(),
+        comparison.change_candidates.len(),
+        comparison.old_coverage.ratio,
+        comparison.new_coverage.ratio,
+    );
+    for region in &comparison.unresolved_regions {
+        println!(
+            "H4 region old={:?} new={:?} evidence={:?}",
+            region.old_span.as_ref().map(|span| &span.blocks),
+            region.new_span.as_ref().map(|span| &span.blocks),
+            region.evidence,
+        );
+    }
+    assert!(
+        comparison.old_coverage.ratio.unwrap_or(0.0) > 0.3,
+        "known-order page content must be compared around the unknown page: {summary:?}"
+    );
+    assert!(!summary.comparison_complete);
+    Ok(())
+}
