+    fn barrier_span(kind: AlignmentKind, old: &[u64], new: &[u64]) -> AlignmentSpan {
+        AlignmentSpan {
+            kind,
+            old: old.iter().copied().map(BlockId).collect(),
+            new: new.iter().copied().map(BlockId).collect(),
+            score: 0.0,
+            canonical_similarity: 0.0,
+            score_margin: None,
+            confidence: AlignmentConfidence::Low,
+            evidence: Vec::new(),
+            old_separator: None,
+            new_separator: None,
+        }
+    }
+
+    #[test]
+    fn barrier_rejection_splits_runs_without_crossing_an_unproven_position() {
+        let mut spans = vec![barrier_span(
+            AlignmentKind::Unresolved,
+            &[1, 2, 3],
+            &[10, 11],
+        )];
+        let barriers_old = HashSet::from([BlockId(2)]);
+        reject_reading_order_barriers(&mut spans, &barriers_old, &HashSet::new());
+
+        // trusted/barrier/trusted never merges back into one span: the runs
+        // stay separate, the barrier keeps explicit evidence, and the new side
+        // keeps its own span instead of being paired with a partial range.
+        assert_eq!(spans.len(), 4, "{spans:?}");
+        assert!(spans.iter().all(|span| {
+            !(span.old.contains(&BlockId(1)) && span.old.contains(&BlockId(3)))
+        }));
+        let barrier = spans
+            .iter()
+            .find(|span| span.old == vec![BlockId(2)])
+            .expect("barrier run");
+        assert_eq!(barrier.kind, AlignmentKind::Unresolved);
+        assert_eq!(barrier.new, Vec::<BlockId>::new());
+        assert!(
+            barrier
+                .evidence
+                .contains(&AlignmentEvidence::ReadingOrderUnknown)
+        );
+        assert!(spans.iter().any(|span| span.old == vec![BlockId(1)]));
+        assert!(spans.iter().any(|span| span.old == vec![BlockId(3)]));
+        assert!(spans.iter().any(|span| span.new == vec![BlockId(10), BlockId(11)]));
+    }
+
+    #[test]
+    fn barrier_rejection_fails_closed_on_a_match_span() {
+        let mut spans = vec![AlignmentSpan {
+            evidence: vec![AlignmentEvidence::ExactCanonical],
+            ..barrier_span(AlignmentKind::Match, &[4], &[104])
+        }];
+        let barriers_new = HashSet::from([BlockId(104)]);
+        reject_reading_order_barriers(&mut spans, &HashSet::new(), &barriers_new);
+
+        assert_eq!(spans.len(), 1);
+        assert_eq!(spans[0].kind, AlignmentKind::Unresolved);
+        assert_eq!(spans[0].old, vec![BlockId(4)]);
+        assert_eq!(spans[0].new, vec![BlockId(104)]);
+        assert!(
+            spans[0]
+                .evidence
+                .contains(&AlignmentEvidence::ReadingOrderUnknown)
+        );
+        assert!(
+            spans[0]
+                .evidence
+                .contains(&AlignmentEvidence::ExactCanonical)
+        );
+    }
+
+    #[test]
+    fn barrier_rejection_keeps_single_sided_runs_of_deletions_and_insertions() {
+        let mut spans = vec![
+            barrier_span(AlignmentKind::Deletion, &[7], &[]),
+            barrier_span(AlignmentKind::Deletion, &[8], &[]),
+            barrier_span(AlignmentKind::Insertion, &[], &[9]),
+        ];
+        let barriers_old = HashSet::from([BlockId(7)]);
+        let barriers_new = HashSet::from([BlockId(9)]);
+        reject_reading_order_barriers(&mut spans, &barriers_old, &barriers_new);
+
+        assert_eq!(spans.len(), 3);
+        assert_eq!(spans[0].kind, AlignmentKind::Unresolved);
+        assert_eq!(spans[0].old, vec![BlockId(7)]);
+        assert_eq!(spans[1].kind, AlignmentKind::Deletion);
+        assert_eq!(spans[1].old, vec![BlockId(8)]);
+        assert_eq!(spans[2].kind, AlignmentKind::Unresolved);
+        assert_eq!(spans[2].new, vec![BlockId(9)]);
+    }
+
+    #[test]
+    fn barrier_rejection_leaves_spans_without_barriers_untouched() {
+        let mut spans = vec![
+            barrier_span(AlignmentKind::Match, &[1], &[2]),
+            barrier_span(AlignmentKind::Unresolved, &[3], &[]),
+        ];
+        let before = spans.clone();
+        reject_reading_order_barriers(
+            &mut spans,
+            &HashSet::from([BlockId(90)]),
+            &HashSet::from([BlockId(91)]),
+        );
+        assert_eq!(spans, before);
+    }
 }
