+/// Page 0 is a proven-order two-column page with small edits; page 1 is a
+/// vertically overlapping two-column page whose region order is unproven
+/// (row-major and column-major readings are both geometrically coherent).
+fn h4_document(changed: bool) -> Document<Glyph> {
+    let left_old = [
+        "Quarterly revenue increased across all regions",
+        "Operating costs remained stable through the period",
+        "Customer retention improved during the second half",
+        "Margins expanded as the restructuring completed",
+    ];
+    let right_old = [
+        "Headcount grew in every product division",
+        "Research spending rose faster than the plan",
+        "Supply delays eased during the final months",
+        "Guidance stayed unchanged for the full year",
+    ];
+    let left_new = [
+        "Quarterly revenue increased across most regions",
+        "Operating costs remained stable through the quarter",
+        "Customer retention improved during the second quarter",
+        "Margins expanded as the programme completed",
+    ];
+    let right_new = [
+        "Headcount grew in every product segment",
+        "Research spending rose faster than the budget",
+        "Supply delays eased during the closing months",
+        "Guidance stayed unchanged for the whole year",
+    ];
+    let mut lines = Vec::new();
+    for row in 0..4 {
+        let y = 700.0 - row as f64 * 25.0;
+        let left = if changed { left_new[row] } else { left_old[row] };
+        let right = if changed { right_new[row] } else { right_old[row] };
+        lines.push(line_at(left, 0, 50.0, y));
+        lines.push(line_at(right, 0, 700.0, y));
+    }
+    let unknown_old = [
+        "Ambiguous column wording",
+        "Overlapping row band one",
+        "Overlapping row band two",
+    ];
+    let unknown_new = [
+        "Totally other paragraph",
+        "Different wording here",
+        "Another replacement line",
+    ];
+    for row in 0..3 {
+        let y = 300.0 - row as f64 * 14.0;
+        let text = if changed { unknown_new[row] } else { unknown_old[row] };
+        lines.push(line_at(text, 1, 50.0, y));
+        lines.push(line_at(text, 1, 250.0, y));
+    }
+    document(&lines)
+}
