+/// Keeps blocks that sit outside a proven line order out of accepted matches.
+///
+/// Their own position is unproven, so no correspondence may claim them. They
+/// stay in candidate generation and the index, which keeps every rival
+/// occurrence visible to competition; this pass only rejects a match once the
+/// chosen correspondence includes one of them and reports the remainder as
+/// unresolved with explicit reading-order evidence.
+fn reject_reading_order_barriers(
+    spans: &mut Vec<AlignmentSpan>,
+    barrier_old: &HashSet<BlockId>,
+    barrier_new: &HashSet<BlockId>,
+) {
+    if barrier_old.is_empty() && barrier_new.is_empty() {
+        return;
+    }
+    let barrier_evidence = |evidence: &[AlignmentEvidence]| {
+        let mut rejected = Vec::with_capacity(evidence.len() + 1);
+        rejected.extend(evidence.iter().copied());
+        if !rejected.contains(&AlignmentEvidence::ReadingOrderUnknown) {
+            rejected.push(AlignmentEvidence::ReadingOrderUnknown);
+        }
+        rejected
+    };
+    let barrier_span = |old: Vec<BlockId>, new: Vec<BlockId>, evidence: Vec<AlignmentEvidence>| {
+        AlignmentSpan {
+            kind: AlignmentKind::Unresolved,
+            old,
+            new,
+            score: 0.0,
+            canonical_similarity: 0.0,
+            score_margin: None,
+            confidence: AlignmentConfidence::Low,
+            evidence,
+            old_separator: None,
+            new_separator: None,
+        }
+    };
+    // Splits one side's blocks into alternating barrier and non-barrier runs
+    // while preserving the side's own order.
+    let runs = |blocks: &[BlockId], barriers: &HashSet<BlockId>| {
+        let mut split: Vec<(bool, Vec<BlockId>)> = Vec::new();
+        for &block in blocks {
+            let is_barrier = barriers.contains(&block);
+            match split.last_mut() {
+                Some((kind, run)) if *kind == is_barrier => run.push(block),
+                _ => split.push((is_barrier, vec![block])),
+            }
+        }
+        split
+    };
+    let mut output = Vec::with_capacity(spans.len());
+    for span in spans.drain(..) {
+        let old_touches = span.old.iter().any(|block| barrier_old.contains(block));
+        let new_touches = span.new.iter().any(|block| barrier_new.contains(block));
+        if !old_touches && !new_touches {
+            output.push(span);
+            continue;
+        }
+        if span.kind == AlignmentKind::Match {
+            // A correspondence that includes an unproven position cannot be
+            // certified or surgically trimmed; keep it entirely unresolved.
+            output.push(barrier_span(
+                span.old,
+                span.new,
+                barrier_evidence(&span.evidence),
+            ));
+            continue;
+        }
+        // Each remaining contiguous run is emitted on its own side. Merging
+        // the runs into one span would concatenate blocks across an unproven
+        // position, so a trusted/barrier/trusted range keeps its boundaries.
+        for (is_barrier, run) in runs(&span.old, barrier_old) {
+            if is_barrier {
+                output.push(barrier_span(run, Vec::new(), barrier_evidence(&span.evidence)));
+            } else {
+                output.push(AlignmentSpan {
+                    kind: span.kind,
+                    old: run,
+                    new: Vec::new(),
+                    score: span.score,
+                    canonical_similarity: span.canonical_similarity,
+                    score_margin: span.score_margin,
+                    confidence: span.confidence,
+                    evidence: span.evidence.clone(),
+                    old_separator: None,
+                    new_separator: None,
+                });
+            }
+        }
+        for (is_barrier, run) in runs(&span.new, barrier_new) {
+            if is_barrier {
+                output.push(barrier_span(Vec::new(), run, barrier_evidence(&span.evidence)));
+            } else {
+                output.push(AlignmentSpan {
+                    kind: span.kind,
+                    old: Vec::new(),
+                    new: run,
+                    score: span.score,
+                    canonical_similarity: span.canonical_similarity,
+                    score_margin: span.score_margin,
+                    confidence: span.confidence,
+                    evidence: span.evidence.clone(),
+                    old_separator: None,
+                    new_separator: None,
+                });
+            }
+        }
+    }
+    *spans = output;
+}
