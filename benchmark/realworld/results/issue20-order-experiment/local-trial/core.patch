+fn coalesce_stable_hunks(hunks: Vec<AtomicEdit>) -> Vec<AtomicEdit> {
+    let mut rectangles: Vec<AtomicEdit> = Vec::with_capacity(hunks.len());
+    for hunk in hunks {
+        if let Some(previous) = rectangles.last_mut()
+            && previous.old.end == hunk.old.start
+            && previous.new.end == hunk.new.start
+        {
+            previous.old.end = hunk.old.end;
+            previous.new.end = hunk.new.end;
+        } else {
+            rectangles.push(hunk);
+        }
+    }
+    rectangles
+}
+
+fn expanded_stable_hunk(
+    groups: &[super::super::GroupText; 2],
+    hunk: &AtomicEdit,
+) -> Option<super::views::LocalDomain> {
+    let old = &groups[0].tokens;
+    let new = &groups[1].tokens;
+    if hunk.old.start > hunk.old.end
+        || hunk.new.start > hunk.new.end
+        || hunk.old.end > old.len()
+        || hunk.new.end > new.len()
+        || (hunk.old.is_empty() && hunk.new.is_empty())
+    {
+        return None;
+    }
+    let mut old_start = hunk.old.start;
+    let mut new_start = hunk.new.start;
+    let mut old_end = hunk.old.end;
+    let mut new_end = hunk.new.end;
+    if old_start > 0 && new_start > 0 && old[old_start - 1] == new[new_start - 1] {
+        old_start -= 1;
+        new_start -= 1;
+    }
+    if old_end < old.len() && new_end < new.len() && old[old_end] == new[new_end] {
+        old_end += 1;
+        new_end += 1;
     }
+    Some(super::views::LocalDomain {
+        old_span: groups[0].span(old_start, old_end),
+        new_span: groups[1].span(new_start, new_end),
+    })
 }
 
