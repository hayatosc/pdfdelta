+        sequence: &[(usize, usize)],
+        old_len: usize,
+        new_len: usize,
+    ) -> Vec<(usize, usize, usize, usize)> {
+        let mut rectangles = Vec::new();
+        let mut old_cursor = 0;
+        let mut new_cursor = 0;
+        for &(old_index, new_index) in sequence {
+            if old_cursor != old_index || new_cursor != new_index {
+                rectangles.push((old_cursor, old_index, new_cursor, new_index));
+            }
+            old_cursor = old_index + 1;
+            new_cursor = new_index + 1;
+        }
+        if old_cursor != old_len || new_cursor != new_len {
+            rectangles.push((old_cursor, old_len, new_cursor, new_len));
+        }
