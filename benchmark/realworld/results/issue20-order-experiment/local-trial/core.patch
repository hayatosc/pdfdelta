+/// Returns the coalesced insertion/deletion edits whose changed rectangles
+/// occur in every shortest alignment.
+///
+/// A matching diagonal is possible on an optimal path when its forward LCS
+/// rank plus the diagonal and its reverse LCS suffix recover the full LCS
+/// length. A rank with one possible diagonal is therefore present in every
+/// optimal equal-pair sequence. Gaps between adjacent such ranks have fixed
+/// corners; optional ranks are deliberately allowed to invalidate a gap.
+///
+/// A rectangle with non-empty ranges on both sides is represented by a
+/// deletion followed by an insertion, preserving the existing [`AtomicEdit`]
+/// invariant while retaining both coordinates. `None` means the shared work
+/// budget ended before the proof completed.
+///
+/// # Errors
+///
+/// Returns [`Error::LimitExceeded`] when checked dimensions or retained
+/// buffers exceed their limits. Returns [`Error::Unresolved`] when a bounded
+/// allocation cannot be reserved.
+pub(super) fn stable_hunks<T: Eq>(
+    old: &[T],
+    new: &[T],
+    remaining_work: &mut usize,
+) -> Result<Option<Vec<AtomicEdit>>> {
+    let token_count = old
+        .len()
+        .checked_add(new.len())
+        .ok_or(Error::LimitExceeded {
+            resource: STABLE_CELLS_RESOURCE,
+            limit: usize::MAX,
+        })?;
+
+    if old.len() == new.len() {
+        let mut identical = true;
+        for (old_token, new_token) in old.iter().zip(new) {
+            if !charge_cell(remaining_work) {
+                return Ok(None);
+            }
+            if old_token != new_token {
+                identical = false;
+                break;
+            }
+        }
+        if identical {
+            return Ok(Some(Vec::new()));
+        }
+    }
+
+    if old.is_empty() || new.is_empty() {
+        if !charge_work(remaining_work, token_count) {
+            return Ok(None);
+        }
+        let mut edits = Vec::new();
+        edits
+            .try_reserve_exact(1)
+            .map_err(|_| Error::Unresolved("stable hunk edit allocation failed".to_owned()))?;
+        edits.push(AtomicEdit {
+            old: 0..old.len(),
+            new: 0..new.len(),
+        });
+        return Ok(Some(edits));
+    }
+
+    let forward_cells = old
+        .len()
+        .checked_mul(new.len())
+        .ok_or(Error::LimitExceeded {
+            resource: STABLE_CELLS_RESOURCE,
+            limit: usize::MAX,
+        })?;
+    let dp_cells = forward_cells.checked_mul(2).ok_or(Error::LimitExceeded {
+        resource: STABLE_CELLS_RESOURCE,
+        limit: usize::MAX,
+    })?;
+    if dp_cells > *remaining_work {
+        return Ok(None);
+    }
+
+    let columns = new.len().checked_add(1).ok_or(Error::LimitExceeded {
+        resource: STABLE_CELLS_RESOURCE,
+        limit: usize::MAX,
+    })?;
+    let rows = old.len().checked_add(1).ok_or(Error::LimitExceeded {
+        resource: STABLE_CELLS_RESOURCE,
+        limit: usize::MAX,
+    })?;
+    let prefix_cells = rows.checked_mul(columns).ok_or(Error::LimitExceeded {
+        resource: STABLE_CELLS_RESOURCE,
+        limit: usize::MAX,
+    })?;
+    let cell_bytes = std::mem::size_of::<usize>();
+    let prefix_bytes = prefix_cells
+        .checked_mul(cell_bytes)
+        .ok_or(Error::LimitExceeded {
+            resource: STABLE_MEMORY_RESOURCE,
+            limit: MAX_EXACT_MEMORY_BYTES,
+        })?;
+    let row_bytes = columns
+        .checked_mul(cell_bytes)
+        .ok_or(Error::LimitExceeded {
+            resource: STABLE_MEMORY_RESOURCE,
+            limit: MAX_EXACT_MEMORY_BYTES,
+        })?;
+    let rolling_bytes = row_bytes.checked_mul(2).ok_or(Error::LimitExceeded {
+        resource: STABLE_MEMORY_RESOURCE,
+        limit: MAX_EXACT_MEMORY_BYTES,
+    })?;
+    let base_bytes = prefix_bytes
+        .checked_add(rolling_bytes)
+        .ok_or(Error::LimitExceeded {
+            resource: STABLE_MEMORY_RESOURCE,
+            limit: MAX_EXACT_MEMORY_BYTES,
+        })?;
+    if base_bytes > MAX_EXACT_MEMORY_BYTES {
+        return Err(Error::LimitExceeded {
+            resource: STABLE_MEMORY_RESOURCE,
+            limit: MAX_EXACT_MEMORY_BYTES,
+        });
+    }
+
+    let mut prefix = Vec::<usize>::new();
+    prefix
+        .try_reserve_exact(prefix_cells)
+        .map_err(|_| Error::Unresolved("stable hunk prefix table allocation failed".to_owned()))?;
+    prefix.resize(prefix_cells, 0);
+
+    for (old_index, old_token) in old.iter().enumerate() {
+        let previous_row = old_index * columns;
+        let current_row = (old_index + 1) * columns;
+        for new_index in 0..new.len() {
+            if !charge_cell(remaining_work) {
+                return Ok(None);
+            }
+            prefix[current_row + new_index + 1] = if *old_token == new[new_index] {
+                prefix[previous_row + new_index]
+                    .checked_add(1)
+                    .ok_or(Error::LimitExceeded {
+                        resource: STABLE_CELLS_RESOURCE,
+                        limit: usize::MAX,
+                    })?
+            } else {
+                prefix[previous_row + new_index + 1].max(prefix[current_row + new_index])
+            };
+        }
+    }
+
+    let mut suffix_next = allocate_row(columns, "stable hunk suffix row")?;
+    let mut suffix_current = allocate_row(columns, "stable hunk suffix row")?;
+    let lcs_length = prefix[prefix_cells - 1];
+    let position_bytes = lcs_length
+        .checked_mul(2)
+        .and_then(|entries| entries.checked_mul(cell_bytes))
+        .ok_or(Error::LimitExceeded {
+            resource: STABLE_MEMORY_RESOURCE,
+            limit: MAX_EXACT_MEMORY_BYTES,
+        })?;
+    if base_bytes
+        .checked_add(position_bytes)
+        .ok_or(Error::LimitExceeded {
+            resource: STABLE_MEMORY_RESOURCE,
+            limit: MAX_EXACT_MEMORY_BYTES,
+        })?
+        > MAX_EXACT_MEMORY_BYTES
+    {
+        return Err(Error::LimitExceeded {
+            resource: STABLE_MEMORY_RESOURCE,
+            limit: MAX_EXACT_MEMORY_BYTES,
+        });
+    }
+    let mut rank_positions = Vec::<[usize; 2]>::new();
+    rank_positions
+        .try_reserve_exact(lcs_length)
+        .map_err(|_| Error::Unresolved("stable hunk rank allocation failed".to_owned()))?;
+    rank_positions.resize(lcs_length, [NO_STABLE_DIAGONAL; 2]);
+
+    for old_index in (0..old.len()).rev() {
+        suffix_current.fill(0);
+        let prefix_row = old_index * columns;
+        for new_index in (0..new.len()).rev() {
+            if !charge_cell(remaining_work) {
+                return Ok(None);
+            }
+            let suffix_after_match = suffix_next[new_index + 1];
+            suffix_current[new_index] = if old[old_index] == new[new_index] {
+                let through_match = prefix[prefix_row + new_index]
+                    .checked_add(1)
+                    .and_then(|length| length.checked_add(suffix_after_match))
+                    .ok_or(Error::LimitExceeded {
+                        resource: STABLE_CELLS_RESOURCE,
+                        limit: usize::MAX,
+                    })?;
+                if through_match == lcs_length {
+                    let rank = prefix[prefix_row + new_index];
+                    let position = &mut rank_positions[rank];
+                    if position[0] == NO_STABLE_DIAGONAL {
+                        *position = [old_index, new_index];
+                    } else {
+                        *position = [MULTIPLE_STABLE_DIAGONALS; 2];
+                    }
+                }
+                suffix_after_match
+                    .checked_add(1)
+                    .ok_or(Error::LimitExceeded {
+                        resource: STABLE_CELLS_RESOURCE,
+                        limit: usize::MAX,
+                    })?
+            } else {
+                suffix_current[new_index + 1].max(suffix_next[new_index])
+            };
+        }
+        std::mem::swap(&mut suffix_current, &mut suffix_next);
+    }
+
+    debug_assert_eq!(suffix_next[0], lcs_length);
+
+    let edit_count = stable_edit_count(&rank_positions, old.len(), new.len(), remaining_work)?;
+    let Some(edit_count) = edit_count else {
+        return Ok(None);
+    };
+
+    drop(prefix);
+    drop(suffix_next);
+    drop(suffix_current);
+
+    let edit_bytes = edit_count
+        .checked_mul(std::mem::size_of::<AtomicEdit>())
+        .ok_or(Error::LimitExceeded {
+            resource: STABLE_MEMORY_RESOURCE,
+            limit: MAX_EXACT_MEMORY_BYTES,
+        })?;
+    if position_bytes
+        .checked_add(edit_bytes)
+        .ok_or(Error::LimitExceeded {
+            resource: STABLE_MEMORY_RESOURCE,
+            limit: MAX_EXACT_MEMORY_BYTES,
+        })?
+        > MAX_EXACT_MEMORY_BYTES
+    {
+        return Err(Error::LimitExceeded {
+            resource: STABLE_MEMORY_RESOURCE,
+            limit: MAX_EXACT_MEMORY_BYTES,
+        });
+    }
+
+    let mut edits = Vec::new();
+    edits
+        .try_reserve_exact(edit_count)
+        .map_err(|_| Error::Unresolved("stable hunk edit allocation failed".to_owned()))?;
+    if rank_positions.is_empty() {
+        if !append_stable_gap(&mut edits, 0, old.len(), 0, new.len(), remaining_work) {
+            return Ok(None);
+        }
+    } else {
+        let Some(()) = append_stable_edits(
+            &rank_positions,
+            old.len(),
+            new.len(),
+            &mut edits,
+            remaining_work,
+        ) else {
+            return Ok(None);
+        };
+    }
+    debug_assert_eq!(edits.len(), edit_count);
+    Ok(Some(edits))
+}
+
+fn stable_edit_count(
+    rank_positions: &[[usize; 2]],
+    old_len: usize,
+    new_len: usize,
+    remaining_work: &mut usize,
+) -> Result<Option<usize>> {
+    if rank_positions.is_empty() {
+        return Ok(Some(gap_edit_count(0, old_len, 0, new_len)));
+    }
+
+    let mut edit_count = 0usize;
+    let mut previous_rank: Option<usize> = None;
+    let mut previous_end = [0, 0];
+    for (rank, position) in rank_positions.iter().enumerate() {
+        if !charge_cell(remaining_work) {
+            return Ok(None);
+        }
+        if position[0] == NO_STABLE_DIAGONAL || position[0] == MULTIPLE_STABLE_DIAGONALS {
+            continue;
+        }
+        let adjacent = match previous_rank {
+            None => rank == 0,
+            Some(previous) => previous.checked_add(1) == Some(rank),
+        };
+        if adjacent {
+            edit_count = edit_count
+                .checked_add(gap_edit_count(
+                    previous_end[0],
+                    position[0],
+                    previous_end[1],
+                    position[1],
+                ))
+                .ok_or(Error::LimitExceeded {
+                    resource: STABLE_CELLS_RESOURCE,
+                    limit: usize::MAX,
+                })?;
+        }
+        previous_end = [
+            position[0].checked_add(1).ok_or(Error::LimitExceeded {
+                resource: STABLE_CELLS_RESOURCE,
+                limit: usize::MAX,
+            })?,
+            position[1].checked_add(1).ok_or(Error::LimitExceeded {
+                resource: STABLE_CELLS_RESOURCE,
+                limit: usize::MAX,
+            })?,
+        ];
+        previous_rank = Some(rank);
+    }
+    if previous_rank == Some(rank_positions.len() - 1) {
+        edit_count = edit_count
+            .checked_add(gap_edit_count(
+                previous_end[0],
+                old_len,
+                previous_end[1],
+                new_len,
+            ))
+            .ok_or(Error::LimitExceeded {
+                resource: STABLE_CELLS_RESOURCE,
+                limit: usize::MAX,
+            })?;
+    }
+    Ok(Some(edit_count))
+}
+
+fn append_stable_edits(
+    rank_positions: &[[usize; 2]],
+    old_len: usize,
+    new_len: usize,
+    edits: &mut Vec<AtomicEdit>,
+    remaining_work: &mut usize,
+) -> Option<()> {
+    let mut previous_rank: Option<usize> = None;
+    let mut previous_end = [0, 0];
+    for (rank, position) in rank_positions.iter().enumerate() {
+        if !charge_cell(remaining_work) {
+            return None;
+        }
+        if position[0] == NO_STABLE_DIAGONAL || position[0] == MULTIPLE_STABLE_DIAGONALS {
+            continue;
+        }
+        let adjacent = match previous_rank {
+            None => rank == 0,
+            Some(previous) => previous.checked_add(1) == Some(rank),
+        };
+        if adjacent
+            && !append_stable_gap(
+                edits,
+                previous_end[0],
+                position[0],
+                previous_end[1],
+                position[1],
+                remaining_work,
+            )
+        {
+            return None;
+        }
+        previous_end = [position[0].checked_add(1)?, position[1].checked_add(1)?];
+        previous_rank = Some(rank);
+    }
+    if previous_rank == Some(rank_positions.len() - 1)
+        && !append_stable_gap(
+            edits,
+            previous_end[0],
+            old_len,
+            previous_end[1],
+            new_len,
+            remaining_work,
+        )
+    {
+        return None;
+    }
+    Some(())
+}
+
+fn append_stable_gap(
+    edits: &mut Vec<AtomicEdit>,
+    old_start: usize,
+    old_end: usize,
+    new_start: usize,
+    new_end: usize,
+    remaining_work: &mut usize,
+) -> bool {
+    if old_start < old_end {
+        if !charge_cell(remaining_work) {
+            return false;
+        }
+        edits.push(AtomicEdit {
+            old: old_start..old_end,
+            new: new_start..new_start,
+        });
+    }
+    if new_start < new_end {
+        if !charge_cell(remaining_work) {
+            return false;
+        }
+        edits.push(AtomicEdit {
+            old: old_end..old_end,
+            new: new_start..new_end,
+        });
+    }
+    true
+}
+
+fn gap_edit_count(old_start: usize, old_end: usize, new_start: usize, new_end: usize) -> usize {
+    usize::from(old_start < old_end) + usize::from(new_start < new_end)
+}
+
+fn charge_work(remaining_work: &mut usize, work: usize) -> bool {
+    if work > *remaining_work {
+        *remaining_work = 0;
+        return false;
+    }
+    *remaining_work -= work;
+    true
+}
