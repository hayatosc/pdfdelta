+    let Some(anchors) = anchors.filter(|anchors| !anchors.pairs.is_empty()) else {
+        return append_cross_granularity_replacements(
+            plan,
+            old_side,
+            new_side,
+            old_occurrences,
+            new_occurrences,
+            min_context,
+            budget,
+        );
+    };
+
+    let mut trial_plan = SentenceRecoveryPlan::default();
+    if trial_plan
+        .deletion_consumed
+        .try_reserve_exact(plan.deletion_consumed.len())
+        .is_err()
+        || trial_plan
+            .insertion_consumed
+            .try_reserve_exact(plan.insertion_consumed.len())
+            .is_err()
+    {
+        return CrossGranularityOutcome::Stopped(
+            cross_granularity::CrossGranularityStopReason::AllocationFailure,
+        );
+    }
+    trial_plan
+        .deletion_consumed
+        .extend_from_slice(&plan.deletion_consumed);
+    trial_plan
+        .insertion_consumed
+        .extend_from_slice(&plan.insertion_consumed);
+    let mut trial_budget = *budget;
+    let outcome = append_cross_granularity_replacements(
+        &mut trial_plan,
+        old_side,
+        new_side,
+        old_occurrences,
+        new_occurrences,
+        min_context,
+        &mut trial_budget,
+    );
+    if !outcome.is_complete() {
+        return outcome;
+    }
+
+    let mut retained = Vec::new();
+    if retained
+        .try_reserve_exact(trial_plan.replacements.len())
+        .is_err()
+    {
+        return CrossGranularityOutcome::Stopped(
+            cross_granularity::CrossGranularityStopReason::AllocationFailure,
+        );
+    }
+    for replacement in trial_plan.replacements {
+        if anchors.allows_replacement(&replacement.old_consumed, &replacement.new_consumed) {
+            retained.push(replacement);
+        }
+    }
+    let Some(old_consumed_count) = retained.iter().try_fold(0usize, |total, replacement| {
+        total.checked_add(replacement.old_consumed.len())
