+fn append_anchor_safe_cross_granularity_replacements(
+    plan: &mut SentenceRecoveryPlan,
+    old_side: &Side<'_>,
+    new_side: &Side<'_>,
+    old_occurrences: &[SentenceOccurrence],
+    new_occurrences: &[SentenceOccurrence],
