+        return CrossGranularityOutcome::Stopped(
+            cross_granularity::CrossGranularityStopReason::CounterOverflow,
+        );
+    };
+    let Some(new_consumed_count) = retained.iter().try_fold(0usize, |total, replacement| {
+        total.checked_add(replacement.new_consumed.len())
+    }) else {
+        return CrossGranularityOutcome::Stopped(
+            cross_granularity::CrossGranularityStopReason::CounterOverflow,
+        );
+    };
+    if plan.replacements.try_reserve_exact(retained.len()).is_err()
+        || plan
+            .deletion_consumed
+            .try_reserve_exact(old_consumed_count)
+            .is_err()
+        || plan
+            .insertion_consumed
+            .try_reserve_exact(new_consumed_count)
+            .is_err()
+    {
+        return CrossGranularityOutcome::Stopped(
+            cross_granularity::CrossGranularityStopReason::AllocationFailure,
+        );
+    }
+    let committed = retained.len();
+    for replacement in retained {
+        plan.deletion_consumed
+            .extend(replacement.old_consumed.iter().copied());
+        plan.insertion_consumed
+            .extend(replacement.new_consumed.iter().copied());
+        plan.replacements.push(replacement);
