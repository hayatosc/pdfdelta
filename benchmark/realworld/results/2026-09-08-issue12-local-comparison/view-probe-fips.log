ISSUE12_BLOCK {"id":1788,"index":1788,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(178), start: 21, end: 22 })","issues":"[]","pages":[85],"side":0,"text":"determined by Appendix C.3.3. "}
