ISSUE12_BLOCK {"id":1555,"index":1555,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(143), start: 6, end: 7 })","issues":"[]","pages":[73],"side":1,"text":"B.7 Trial Division "}
ISSUE12_BLOCK {"id":1556,"index":1556,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(143), start: 7, end: 9 })","issues":"[]","pages":[73],"side":1,"text":"An integer is proven to be prime by showing that it has no prime factors less than or equal to its square root. This procedure is not recommended for testing any integers longer than 10 digits. "}
