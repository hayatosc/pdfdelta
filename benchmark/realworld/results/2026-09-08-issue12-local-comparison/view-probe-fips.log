ISSUE12_BLOCK {"id":243,"index":243,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(27), start: 2, end: 3 })","issues":"[]","pages":[13],"side":0,"text":"Private key "}
ISSUE12_BLOCK {"id":244,"index":244,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(27), start: 3, end: 8 })","issues":"[]","pages":[13],"side":0,"text":"A cryptographic key that is used with an asymmetric (public key) cryptographic algorithm. For digital signatures, the private key is uniquely associated with the owner and is not made public. The private key is used to compute a digital signature that may be verified using the corresponding public key. "}
ISSUE12_BLOCK {"id":245,"index":245,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(27), start: 8, end: 9 })","issues":"[]","pages":[13],"side":0,"text":"Probable prime "}
ISSUE12_BLOCK {"id":246,"index":246,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(27), start: 9, end: 12 })","issues":"[]","pages":[13],"side":0,"text":"An integer that is believed to be prime, based on a probabilistic primality test. There should be no more than a negligible probability that the so-called probable prime is actually composite. "}
ISSUE12_BLOCK {"id":247,"index":247,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(27), start: 12, end: 13 })","issues":"[]","pages":[13],"side":0,"text":"Provable prime "}
ISSUE12_BLOCK {"id":248,"index":248,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(27), start: 13, end: 15 })","issues":"[]","pages":[13],"side":0,"text":"An integer that is either constructed to be prime or is calculated to be prime using a primality-proving algorithm. "}
ISSUE12_BLOCK {"id":249,"index":249,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(27), start: 15, end: 16 })","issues":"[]","pages":[13],"side":0,"text":"Pseudorandom "}
ISSUE12_BLOCK {"id":250,"index":250,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(27), start: 16, end: 21 })","issues":"[]","pages":[13],"side":0,"text":"A process or data produced by a process is said to be pseudorandom when the outcome is deterministic, yet also effectively random as long as the internal action of the process is hidden from observation. For cryptographic purposes, “effectively” means “within the limits of the intended security strength.” "}
ISSUE12_BLOCK {"id":251,"index":251,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(27), start: 21, end: 22 })","issues":"[]","pages":[13],"side":0,"text":"Public key "}
ISSUE12_BLOCK {"id":252,"index":252,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(27), start: 22, end: 27 })","issues":"[]","pages":[13],"side":0,"text":"A cryptographic key that is used with an asymmetric (public key) cryptographic algorithm and is associated with a private key. The public key is associated with an owner and may be made public. In the case of digital signatures, the public key is used to verify a digital signature that was signed using the corresponding private key. "}
ISSUE12_BLOCK {"id":253,"index":253,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(27), start: 27, end: 28 })","issues":"[]","pages":[13],"side":0,"text":"Security strength A number associated with the amount of work (that is, the number of "}
ISSUE12_BLOCK {"id":254,"index":254,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(27), start: 28, end: 30 })","issues":"[]","pages":[13],"side":0,"text":"operations) that is required to break a cryptographic algorithm or system. Sometimes referred to as a security level. "}
