ISSUE12_BLOCK {"id":1937,"index":1937,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(189), start: 29, end: 30 })","issues":"[]","pages":[92],"side":0,"text":"2. N1 "}
ISSUE12_BLOCK {"id":1938,"index":1938,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(189), start: 30, end: 33 })","issues":"[]","pages":[92],"side":0,"text":"A positive integer equal to the requested bit-length for p1. If N1 ≥ 2, then p1 is an odd prime of N1 bits; otherwise, p1 = 1. Acceptable values for N1 ≥ 2 are provided in Table B.1 "}
