ISSUE12_BLOCK {"id":1847,"index":1847,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(182), start: 5, end: 7 })","issues":"[]","pages":[88],"side":0,"text":"12. If (prime_gen_counter > (4 ∗ length)), then return (FAILURE, 0, 0 {, 0}). 13. Go to step 5. "}
ISSUE12_BLOCK {"id":1848,"index":1848,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(182), start: 7, end: 9 })","issues":"[]","pages":[88],"side":0,"text":"14. (status, c0, prime_seed, prime_gen_counter) = (ST_Random_Prime (( length / 2 + 1), input_seed). "}
ISSUE12_BLOCK {"id":1849,"index":1849,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(182), start: 9, end: 10 })","issues":"[]","pages":[88],"side":0,"text":"15. If FAILURE is returned, return (FAILURE, 0, 0 {, 0}). "}
ISSUE12_BLOCK {"id":1850,"index":1850,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(182), start: 10, end: 12 })","issues":"[]","pages":[88],"side":0,"text":"16. iterations = length / outlen – 1. 17. old_counter = prime_gen_counter. "}
ISSUE12_BLOCK {"id":1851,"index":1851,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(182), start: 12, end: 14 })","issues":"[]","pages":[88],"side":0,"text":"Comment: Generate a pseudorandom integer x in the interval [2length – 1, 2length]. "}
ISSUE12_BLOCK {"id":1852,"index":1852,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(182), start: 14, end: 16 })","issues":"[]","pages":[88],"side":0,"text":"18. x = 0. 19. For i = 0 to iterations do "}
ISSUE12_BLOCK {"id":1853,"index":1853,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(182), start: 16, end: 17 })","issues":"[]","pages":[88],"side":0,"text":"x = x + (Hash(prime_seed + i) ∗ 2i × outlen). "}
ISSUE12_BLOCK {"id":1854,"index":1854,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(182), start: 17, end: 18 })","issues":"[]","pages":[88],"side":0,"text":"20. prime_seed = prime_seed + iterations + 1. "}
ISSUE12_BLOCK {"id":1855,"index":1855,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(182), start: 18, end: 19 })","issues":"[]","pages":[88],"side":0,"text":"21. x = 2length – 1 + (x mod 2length – 1). "}
ISSUE12_BLOCK {"id":1856,"index":1856,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(182), start: 19, end: 21 })","issues":"[]","pages":[88],"side":0,"text":"Comment: Generate a candidate prime c in the interval [2length – 1, 2length]. "}
ISSUE12_BLOCK {"id":1857,"index":1857,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(182), start: 21, end: 24 })","issues":"[]","pages":[88],"side":0,"text":"22. t = x / (2c0). 23. If (2tc0 + 1 > 2length), then t = 2length – 1 / (2c0). 24. c = 2tc0 + 1. "}
ISSUE12_BLOCK {"id":1858,"index":1858,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(182), start: 24, end: 25 })","issues":"[]","pages":[88],"side":0,"text":"25. prime_gen_counter = prime_gen_counter + 1. "}
ISSUE12_BLOCK {"id":1859,"index":1859,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(182), start: 25, end: 28 })","issues":"[]","pages":[88],"side":0,"text":"Comment: Test the candidate prime c for primality; first pick an integer a between 2 and c – 2. "}
ISSUE12_BLOCK {"id":1860,"index":1860,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(182), start: 28, end: 30 })","issues":"[]","pages":[88],"side":0,"text":"26. a = 0. 27. For i = 0 to iterations do "}
ISSUE12_BLOCK {"id":1861,"index":1861,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(182), start: 30, end: 31 })","issues":"[]","pages":[88],"side":0,"text":"a = a + (Hash(prime_seed + i) ∗ 2 i * outlen). "}
