ISSUE12_BLOCK {"id":418,"index":418,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(47), start: 0, end: 1 })","issues":"[]","pages":[21],"side":1,"text":"the Digital Signature Process "}
ISSUE12_BLOCK {"id":419,"index":419,"interval":"None","issues":"[]","pages":[21],"side":1,"text":"Generate a Digital Signature "}
ISSUE12_BLOCK {"id":420,"index":420,"interval":"None","issues":"[]","pages":[21],"side":1,"text":"Verify the Digital Signature "}
ISSUE12_BLOCK {"id":421,"index":421,"interval":"None","issues":"[]","pages":[21],"side":1,"text":"Optional "}
