ISSUE12_BLOCK {"id":1759,"index":1759,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(177), start: 17, end: 18 })","issues":"[]","pages":[84],"side":0,"text":"Process: "}
ISSUE12_BLOCK {"id":1760,"index":1760,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(177), start: 18, end: 23 })","issues":"[]","pages":[84],"side":0,"text":"1. Set n, such that 2n > C ≥ 2(n−1). 2. m = n/2. 3. i = 0. 4. Select X0, such that 2m > X0 ≥ 2(m−1). 5. Repeat "}
ISSUE12_BLOCK {"id":1761,"index":1761,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(177), start: 23, end: 25 })","issues":"[]","pages":[84],"side":0,"text":"5.1 i = i + 1. 5.2 Xi = ((Xi–1)2 + C)/(2Xi–1). "}
ISSUE12_BLOCK {"id":1762,"index":1762,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(177), start: 25, end: 26 })","issues":"[]","pages":[84],"side":0,"text":"Until (Xi)2 < 2m + C. "}
ISSUE12_BLOCK {"id":1763,"index":1763,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(177), start: 26, end: 27 })","issues":"[]","pages":[84],"side":0,"text":"6. If C =  Xi  2, then "}
ISSUE12_BLOCK {"id":1764,"index":1764,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(177), start: 27, end: 28 })","issues":"[]","pages":[84],"side":0,"text":" status = PERFECT SQUARE. "}
ISSUE12_BLOCK {"id":1765,"index":1765,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(177), start: 28, end: 29 })","issues":"[]","pages":[84],"side":0,"text":" Else "}
