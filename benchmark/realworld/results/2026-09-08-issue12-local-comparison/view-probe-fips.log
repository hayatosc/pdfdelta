ISSUE12_BLOCK {"id":971,"index":971,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(113), start: 29, end: 31 })","issues":"[]","pages":[50],"side":0,"text":"previously tried. Note that h could be obtained from a random number generator or from a counter that changes after each use. "}
ISSUE12_BLOCK {"id":972,"index":972,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(113), start: 31, end: 32 })","issues":"[]","pages":[50],"side":0,"text":"3. g = he mod p. "}
