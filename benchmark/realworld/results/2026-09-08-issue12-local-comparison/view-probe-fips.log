ISSUE12_BLOCK {"id":1784,"index":1784,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(178), start: 17, end: 18 })","issues":"[]","pages":[85],"side":0,"text":"Input: "}
ISSUE12_BLOCK {"id":1785,"index":1785,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(178), start: 18, end: 19 })","issues":"[]","pages":[85],"side":0,"text":"a Any integer. For this Standard, the initial value is in the sequence {5, –7, 9, –11, "}
ISSUE12_BLOCK {"id":1786,"index":1786,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(178), start: 19, end: 20 })","issues":"[]","pages":[85],"side":0,"text":"13, –15, 17, …}, as determined by Appendix C.3.3. "}
