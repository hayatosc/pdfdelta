ISSUE12_BLOCK {"id":539,"index":539,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(75), start: 3, end: 4 })","issues":"[]","pages":[23],"side":0,"text":"of the Owner’s Public Key"}
ISSUE12_BLOCK {"id":540,"index":540,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(75), start: 4, end: 5 })","issues":"[]","pages":[23],"side":0,"text":"Obtain Assurance that the Owner "}
