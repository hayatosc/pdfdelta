ISSUE12_VIEW {"blocks":[1797],"index":1441,"kind":"Untrusted(1797)","side":1,"tokens":"Below is a summary of the main changes made in revising FIPS 186-4:  "}
ISSUE12_VIEW {"blocks":[1798],"index":1442,"kind":"Untrusted(1798)","side":1,"tokens":"• DSA is no longer approved for digital signature generation. DSA may be used to verify "}
ISSUE12_VIEW {"blocks":[1799],"index":1443,"kind":"Untrusted(1799)","side":1,"tokens":"signatures generated prior to the implementation date of this standard. "}
