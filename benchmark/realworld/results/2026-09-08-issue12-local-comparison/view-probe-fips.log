ISSUE12_BLOCK {"id":222,"index":222,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(23), start: 29, end: 30 })","issues":"[]","pages":[12],"side":0,"text":"Message digest "}
ISSUE12_BLOCK {"id":223,"index":223,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(23), start: 30, end: 32 })","issues":"[]","pages":[12],"side":0,"text":"The result of applying a hash function to a message. Also known as “hash value”. "}
ISSUE12_BLOCK {"id":224,"index":224,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(23), start: 32, end: 33 })","issues":"[]","pages":[12],"side":0,"text":"Non-repudiation A service that is used to provide assurance of the integrity and origin "}
ISSUE12_BLOCK {"id":225,"index":225,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(23), start: 33, end: 36 })","issues":"[]","pages":[12],"side":0,"text":"of data in such a way that the integrity and origin can be verified and validated by a third party as having originated from a specific entity in possession of the private key (i.e., the signatory). "}
