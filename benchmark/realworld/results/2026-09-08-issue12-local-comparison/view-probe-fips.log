ISSUE12_BLOCK {"id":1834,"index":1834,"interval":"Some(TrustedRunInterval { run_id: TrustedRunId(180), start: 29, end: 31 })","issues":"[]","pages":[87],"side":0,"text":"6. c = 2length – 1 + (c mod 2length – 1). 7. c = (2 ∗ c / 2 ) + 1. "}
