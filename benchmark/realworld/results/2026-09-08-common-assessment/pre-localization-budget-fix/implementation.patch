+        crate::normalize::BlockText {
+            block: BlockId(id),
+            role: BlockRole::Body,
+            raw: canonical.clone(),
+            canonical,
+            matching: text.to_owned(),
+            matching_tokens: tokens,
+            numeric_mask_applied: false,
+            normalization_events: Vec::new(),
+            issues: Vec::new(),
+            pages: Vec::new(),
+            font_size_signatures: None,
