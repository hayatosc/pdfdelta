+    assert_eq!(
+        json["assessment"]["old_resolution"][0]["comparable_range"],
+        serde_json::json!({"start": 0, "end": 5})
+    );
+    assert_eq!(
+        json["assessment"]["old_resolution"][0]["state"],
+        "unresolved"
+    );
+    Ok(())
+}
