+            empty_calls += 1;
+            Ok(Some(()))
+        })
+        .expect("empty inputs need no work");
+        assert_eq!(
+            empty,
+            Outcome::Unique {
+                signature: (),
+                edits: Vec::new()
+            }
+        );
+        assert_eq!(empty_calls, 1);
