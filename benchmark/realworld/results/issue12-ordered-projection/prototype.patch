+                    // Stagger the columns so parallel-row proof does not establish
+                    // their global order, while each column remains monotone.
+                    let y = 300.0 - (index / 2) as f64 * 40.0 - (index % 2) as f64 * 8.0;
+                    glyph.bbox = Rect {
