+struct SourceLayout<'a> {
+    ids: &'a [BlockId],
+    positions: HashMap<BlockId, usize>,
+    excluded: HashSet<BlockId>,
+}
+
+impl<'a> SourceLayout<'a> {
+    fn new(side: &str, ids: &'a [BlockId], excluded: &[BlockId]) -> Result<Self> {
+        let mut positions = HashMap::new();
+        positions
+            .try_reserve(ids.len())
+            .map_err(|_| Error::LimitExceeded {
+                resource: "ordered source layout",
+                limit: ids.len(),
+            })?;
+        for (position, &block) in ids.iter().enumerate() {
+            if positions.insert(block, position).is_some() {
+                return Err(Error::Unresolved(format!(
+                    "duplicate {side} source block id {}",
+                    block.0
+                )));
+            }
+        }
+        let mut excluded_set = HashSet::new();
+        excluded_set
+            .try_reserve(excluded.len())
+            .map_err(|_| Error::LimitExceeded {
+                resource: "ordered excluded source ids",
+                limit: excluded.len(),
+            })?;
+        for &block in excluded {
+            if !positions.contains_key(&block) {
+                return Err(Error::Unresolved(format!(
+                    "excluded {side} source block {} is missing from the full source",
+                    block.0
+                )));
+            }
+            if !excluded_set.insert(block) {
+                return Err(Error::Unresolved(format!(
+                    "duplicate excluded {side} source block id {}",
+                    block.0
+                )));
+            }
+        }
+        Ok(Self {
+            ids,
+            positions,
+            excluded: excluded_set,
+        })
+    }
+
+    fn position(&self, block: BlockId, side: &str) -> Result<usize> {
+        self.positions.get(&block).copied().ok_or_else(|| {
+            Error::Unresolved(format!(
+                "alignment references unknown {side} source block {}",
+                block.0
+            ))
+        })
+    }
+
+    fn take_before(&self, cursor: &mut usize, target: usize, side: &str) -> Result<Vec<BlockId>> {
+        if target < *cursor {
+            return Err(Error::Unresolved(format!(
+                "alignment {side} source order moved backwards"
+            )));
+        }
+        let mut excluded = Vec::new();
+        excluded
+            .try_reserve(target - *cursor)
+            .map_err(|_| Error::LimitExceeded {
+                resource: "ordered excluded unresolved span",
+                limit: target - *cursor,
+            })?;
+        for &block in &self.ids[*cursor..target] {
+            if self.excluded.contains(&block) {
+                excluded.push(block);
+            } else {
+                return Err(Error::Unresolved(format!(
+                    "alignment skipped {side} source block {}",
+                    block.0
+                )));
+            }
+        }
+        *cursor = target;
+        Ok(excluded)
+    }
+
+    fn take_trailing(&self, cursor: &mut usize, side: &str) -> Result<Vec<BlockId>> {
+        self.take_before(cursor, self.ids.len(), side)
+    }
+}
+
+struct SourceSpanInfo {
+    positions: Vec<usize>,
+    crosses_excluded: bool,
+}
+
+fn source_span_info(
+    blocks: &[BlockId],
+    source: &SourceLayout<'_>,
+    side: &str,
+) -> Result<SourceSpanInfo> {
+    let mut positions = Vec::new();
+    positions
+        .try_reserve_exact(blocks.len())
+        .map_err(|_| Error::LimitExceeded {
+            resource: "ordered source span positions",
+            limit: blocks.len(),
+        })?;
+    for &block in blocks {
+        if source.excluded.contains(&block) {
+            return Err(Error::Unresolved(format!(
+                "projected alignment retained excluded {side} source block {}",
+                block.0
+            )));
+        }
+        let position = source.position(block, side)?;
+        if positions.last().is_some_and(|last| *last >= position) {
+            return Err(Error::Unresolved(format!(
+                "alignment {side} source span is not strictly ordered"
+            )));
+        }
+        positions.push(position);
+    }
+    let Some((&first, &last)) = positions.first().zip(positions.last()) else {
+        return Ok(SourceSpanInfo {
+            positions,
+            crosses_excluded: false,
+        });
+    };
+    let mut block_index = 0;
+    let mut crosses_excluded = false;
+    for &block in &source.ids[first..=last] {
+        if source.excluded.contains(&block) {
+            crosses_excluded = true;
+            continue;
+        }
+        if blocks.get(block_index) != Some(&block) {
+            return Err(Error::Unresolved(format!(
+                "alignment {side} source span skips a retained source block"
+            )));
+        }
+        block_index += 1;
+    }
+    if block_index != blocks.len() {
+        return Err(Error::Unresolved(format!(
+            "alignment {side} source span does not cover its source range"
+        )));
+    }
+    Ok(SourceSpanInfo {
+        positions,
+        crosses_excluded,
+    })
+}
+
+struct AlignmentSourceInfo {
+    old: SourceSpanInfo,
+    new: SourceSpanInfo,
+}
+
+fn add_unresolved_evidence(evidence: &mut Vec<AlignmentEvidence>, extraction_gap: bool) {
+    if extraction_gap && !evidence.contains(&AlignmentEvidence::ExtractionGap) {
+        evidence.push(AlignmentEvidence::ExtractionGap);
+    }
+    if !evidence.contains(&AlignmentEvidence::ReadingOrderUnknown) {
+        evidence.push(AlignmentEvidence::ReadingOrderUnknown);
+    }
+}
+
+fn add_partial_evidence(span: &mut AlignmentSpan) {
+    if !span
+        .evidence
+        .contains(&AlignmentEvidence::ReadingOrderPartial)
+    {
+        span.evidence.push(AlignmentEvidence::ReadingOrderPartial);
+    }
+}
+
+fn excluded_span(old: Vec<BlockId>, new: Vec<BlockId>, extraction_gap: bool) -> AlignmentSpan {
+    let mut evidence = Vec::with_capacity(2);
+    add_unresolved_evidence(&mut evidence, extraction_gap);
+    AlignmentSpan {
+        kind: AlignmentKind::Unresolved,
+        old,
+        new,
+        score: 0.0,
+        canonical_similarity: 0.0,
+        score_margin: None,
+        confidence: AlignmentConfidence::Low,
+        evidence,
+        old_separator: None,
+        new_separator: None,
+    }
+}
+
+fn crossed_unresolved_span(
+    mut span: AlignmentSpan,
+    old: Vec<BlockId>,
+    new: Vec<BlockId>,
+    extraction_gap: bool,
+) -> AlignmentSpan {
+    span.evidence.clear();
+    add_unresolved_evidence(&mut span.evidence, extraction_gap);
+    span.kind = AlignmentKind::Unresolved;
+    span.old = old;
+    span.new = new;
+    span.score = 0.0;
+    span.canonical_similarity = 0.0;
+    span.score_margin = None;
+    span.confidence = AlignmentConfidence::Low;
+    span.old_separator = None;
+    span.new_separator = None;
+    span
+}
+
+fn source_targets(
+    infos: &[AlignmentSourceInfo],
+    old: bool,
+    source_len: usize,
+) -> Result<Vec<usize>> {
+    let mut targets = Vec::new();
+    targets
+        .try_reserve_exact(infos.len())
+        .map_err(|_| Error::LimitExceeded {
+            resource: "ordered source span targets",
+            limit: infos.len(),
+        })?;
+    targets.resize(infos.len(), source_len);
+    let mut next = source_len;
+    for (index, info) in infos.iter().enumerate().rev() {
+        let positions = if old {
+            &info.old.positions
+        } else {
+            &info.new.positions
+        };
+        if let Some(&first) = positions.first() {
+            next = first;
+        }
+        targets[index] = next;
+    }
+    Ok(targets)
+}
+
+fn source_range_ids(source: &SourceLayout<'_>, positions: &[usize]) -> Vec<BlockId> {
+    let Some((&first, &last)) = positions.first().zip(positions.last()) else {
+        return Vec::new();
+    };
+    source.ids[first..=last].to_vec()
+}
+
+/// Restores omitted source blocks at their original positions in the
+/// alignment. A projected span crossing an omitted block is downgraded to one
+/// unresolved span so source consumption remains exact.
+pub(crate) fn merge_excluded_unresolved(
+    alignment: &mut Alignment,
+    original_old: &[BlockId],
+    original_new: &[BlockId],
+    excluded_old: &[BlockId],
+    excluded_new: &[BlockId],
+    extraction_gap: bool,
+) -> Result<()> {
+    if excluded_old.is_empty() && excluded_new.is_empty() {
+        return Ok(());
+    }
+    let old_source = SourceLayout::new("old", original_old, excluded_old)?;
+    let new_source = SourceLayout::new("new", original_new, excluded_new)?;
+    let mut infos = Vec::new();
+    infos
+        .try_reserve_exact(alignment.spans.len())
+        .map_err(|_| Error::LimitExceeded {
+            resource: "ordered source span positions",
+            limit: alignment.spans.len(),
+        })?;
+    for span in &alignment.spans {
+        if span.old.is_empty() && span.new.is_empty() {
+            return Err(Error::Unresolved(
+                "alignment contains an empty span".to_owned(),
+            ));
+        }
+        infos.push(AlignmentSourceInfo {
+            old: source_span_info(&span.old, &old_source, "old")?,
+            new: source_span_info(&span.new, &new_source, "new")?,
+        });
+    }
+
+    let extra_capacity = excluded_old
+        .len()
+        .checked_add(excluded_new.len())
+        .and_then(|count| alignment.spans.len().checked_add(count))
+        .and_then(|count| count.checked_add(1))
+        .ok_or(Error::LimitExceeded {
+            resource: "ordered excluded unresolved span",
+            limit: usize::MAX,
+        })?;
+    let mut output = Vec::new();
+    output
+        .try_reserve_exact(extra_capacity)
+        .map_err(|_| Error::LimitExceeded {
+            resource: "ordered excluded unresolved span",
+            limit: extra_capacity,
+        })?;
+    let old_targets = source_targets(&infos, true, old_source.ids.len())?;
+    let new_targets = source_targets(&infos, false, new_source.ids.len())?;
+    let mut old_cursor = 0;
+    let mut new_cursor = 0;
+    for (index, mut span) in alignment.spans.iter().cloned().enumerate() {
+        let info = &infos[index];
+        let old_target = old_targets[index];
+        let new_target = new_targets[index];
+        let old_prefix = old_source.take_before(&mut old_cursor, old_target, "old")?;
+        let new_prefix = new_source.take_before(&mut new_cursor, new_target, "new")?;
+        if !old_prefix.is_empty() || !new_prefix.is_empty() {
+            output.push(excluded_span(old_prefix, new_prefix, extraction_gap));
+        }
+
+        add_partial_evidence(&mut span);
+        let crosses_excluded = info.old.crosses_excluded || info.new.crosses_excluded;
+        if crosses_excluded {
+            output.push(crossed_unresolved_span(
+                span,
+                source_range_ids(&old_source, &info.old.positions),
+                source_range_ids(&new_source, &info.new.positions),
+                extraction_gap,
+            ));
+        } else {
+            output.push(span);
+        }
+        if let Some(&last) = info.old.positions.last() {
+            old_cursor = last + 1;
+        }
+        if let Some(&last) = info.new.positions.last() {
+            new_cursor = last + 1;
+        }
+    }
+    let old_trailing = old_source.take_trailing(&mut old_cursor, "old")?;
+    let new_trailing = new_source.take_trailing(&mut new_cursor, "new")?;
+    if !old_trailing.is_empty() || !new_trailing.is_empty() {
+        output.push(excluded_span(old_trailing, new_trailing, extraction_gap));
+    }
+    alignment.spans = output;
+    Ok(())
+}
