+/// Reorders the supported subsequence while retaining omitted lines as barriers
+/// in the raw traversal. A barrier's slot serializes evidence, not proven order.
+/// Moving all omitted lines to the end would permit joins across source gaps.
+fn append_known_line_order<T>(
+    values_by_line_id: &mut HashMap<LineId, T>,
+    ordered_values: &mut Vec<T>,
+    known_order: &[LineId],
+    raw_order: impl IntoIterator<Item = LineId>,
+) -> Result<()> {
+    let mut selected = HashSet::new();
+    selected
+        .try_reserve(known_order.len())
+        .map_err(|_| Error::LimitExceeded {
+            resource: "known line order membership",
+            limit: known_order.len(),
+        })?;
+    selected.extend(known_order.iter().copied());
+    if selected.len() != known_order.len() {
+        return Err(Error::Unresolved(
+            "known line order contains duplicate line ids".to_owned(),
+        ));
+    }
+    let mut known = known_order.iter().copied();
+    for raw_line in raw_order {
+        let line = if selected.remove(&raw_line) {
+            known.next().ok_or_else(|| {
+                Error::Unresolved("raw line order repeats a selected line".to_owned())
+            })?
+        } else {
+            raw_line
+        };
+        append_region_order(values_by_line_id, ordered_values, [line])?;
+    }
+    if known.next().is_some() {
+        return Err(Error::Unresolved(
+            "known line order references a missing raw line".to_owned(),
+        ));
+    }
+    Ok(())
+}
