+/// A bounded feature view that removes source blocks whose reading order is
+/// not globally proven while retaining their identifiers for explicit
+/// unresolved reporting.
+pub(crate) struct OrderedProjection {
+    pub(crate) old: Vec<BlockFeatures>,
+    pub(crate) new: Vec<BlockFeatures>,
+    pub(crate) gap_plan: AlignmentGapPlan,
+    pub(crate) excluded_old: Vec<BlockId>,
+    pub(crate) excluded_new: Vec<BlockId>,
+}
+
+impl OrderedProjection {
+    /// Projects the working feature slices and remaps extraction/layout
+    /// metadata to the projected indices. Exact-anchor uniqueness is measured
+    /// against the complete input slices before excluded blocks are filtered.
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn new(
+        old: &[BlockFeatures],
+        new: &[BlockFeatures],
+        options: AlignmentOptions,
+        old_gap_boundaries: &[usize],
+        new_gap_boundaries: &[usize],
+        old_extraction_uncertain_indices: &[usize],
+        new_extraction_uncertain_indices: &[usize],
+        old_excluded_indices: &[usize],
+        new_excluded_indices: &[usize],
+        old_inferred_indices: &[usize],
+        new_inferred_indices: &[usize],
+    ) -> Result<Self> {
+        validate_alignment_options(options)?;
+        validate_features("old", old)?;
+        validate_features("new", new)?;
+        validate_shared_ngram_size(old, new)?;
+        validate_gap_boundaries("old", old_gap_boundaries, old.len())?;
+        validate_gap_boundaries("new", new_gap_boundaries, new.len())?;
+        validate_uncertain_indices(
+            "old extraction",
+            old_extraction_uncertain_indices,
+            old.len(),
+        )?;
+        validate_uncertain_indices(
+            "new extraction",
+            new_extraction_uncertain_indices,
+            new.len(),
+        )?;
+        validate_uncertain_indices("old inferred", old_inferred_indices, old.len())?;
+        validate_uncertain_indices("new inferred", new_inferred_indices, new.len())?;
+
+        let old_excluded = ExcludedIndices::new("old", old_excluded_indices, old.len())?;
+        let new_excluded = ExcludedIndices::new("new", new_excluded_indices, new.len())?;
+        let (projected_old, excluded_old) = project_features(old, &old_excluded, "old")?;
+        let (projected_new, excluded_new) = project_features(new, &new_excluded, "new")?;
+        let old_gap_boundaries = remap_boundaries(
+            old_gap_boundaries,
+            &old_excluded,
+            "old extraction gap boundary",
+        )?;
+        let new_gap_boundaries = remap_boundaries(
+            new_gap_boundaries,
+            &new_excluded,
+            "new extraction gap boundary",
+        )?;
+        let (old_extraction_uncertain_indices, old_extraction_boundaries) =
+            remap_extraction_uncertain_indices(
+                old_extraction_uncertain_indices,
+                &old_excluded,
+                "old extraction uncertain block index",
+            )?;
+        let (new_extraction_uncertain_indices, new_extraction_boundaries) =
+            remap_extraction_uncertain_indices(
+                new_extraction_uncertain_indices,
+                &new_excluded,
+                "new extraction uncertain block index",
+            )?;
+        let mut old_gap_boundaries = merge_boundaries(
+            old_gap_boundaries,
+            old_extraction_boundaries,
+            "old extraction gap boundaries",
+        )?;
+        let mut new_gap_boundaries = merge_boundaries(
+            new_gap_boundaries,
+            new_extraction_boundaries,
+            "new extraction gap boundaries",
+        )?;
+        old_gap_boundaries.sort_unstable();
+        new_gap_boundaries.sort_unstable();
+        let old_inferred_indices = remap_retained_indices(
+            old_inferred_indices,
+            &old_excluded,
+            "old inferred block index",
+        )?;
+        let new_inferred_indices = remap_retained_indices(
+            new_inferred_indices,
+            &new_excluded,
+            "new inferred block index",
+        )?;
+        let gap_plan = plan_ordered_gaps_with_anchor_census(
+            &projected_old,
+            &projected_new,
+            old,
+            new,
+            options,
+            &old_gap_boundaries,
+            &new_gap_boundaries,
+            &old_extraction_uncertain_indices,
+            &new_extraction_uncertain_indices,
+            &[],
+            &[],
+            &old_inferred_indices,
+            &new_inferred_indices,
+        )?;
+
+        Ok(Self {
+            old: projected_old,
+            new: projected_new,
+            gap_plan,
+            excluded_old,
+            excluded_new,
+        })
+    }
+}
+
+struct ExcludedIndices {
+    sorted: Vec<usize>,
+}
+
+impl ExcludedIndices {
+    fn new(side: &str, indices: &[usize], block_count: usize) -> Result<Self> {
+        let mut sorted = Vec::new();
+        sorted
+            .try_reserve_exact(indices.len())
+            .map_err(|_| Error::LimitExceeded {
+                resource: "ordered projection excluded indices",
+                limit: indices.len(),
+            })?;
+        sorted.extend_from_slice(indices);
+        if sorted.iter().any(|&index| index >= block_count) {
+            return Err(Error::Unresolved(format!(
+                "{side} excluded block index exceeds the normalized block count"
+            )));
+        }
+        sorted.sort_unstable();
+        if sorted.windows(2).any(|pair| pair[0] == pair[1]) {
+            return Err(Error::Unresolved(format!(
+                "duplicate {side} excluded block index"
+            )));
+        }
+        Ok(Self { sorted })
+    }
+
+    fn contains(&self, index: usize) -> bool {
+        self.sorted.binary_search(&index).is_ok()
+    }
+
+    fn remap_index(&self, index: usize) -> usize {
+        index - self.sorted.partition_point(|&excluded| excluded < index)
+    }
+
+    fn remap_boundary(&self, boundary: usize) -> usize {
+        boundary - self.sorted.partition_point(|&excluded| excluded < boundary)
+    }
+}
+
+fn project_features(
+    features: &[BlockFeatures],
+    excluded: &ExcludedIndices,
+    side: &str,
+) -> Result<(Vec<BlockFeatures>, Vec<BlockId>)> {
+    let retained_count =
+        features
+            .len()
+            .checked_sub(excluded.sorted.len())
+            .ok_or(Error::LimitExceeded {
+                resource: "ordered feature projection",
+                limit: features.len(),
+            })?;
+    let mut projected = Vec::new();
+    projected
+        .try_reserve_exact(retained_count)
+        .map_err(|_| Error::LimitExceeded {
+            resource: "ordered feature projection",
+            limit: retained_count,
+        })?;
+    let mut excluded_ids = Vec::new();
+    excluded_ids
+        .try_reserve_exact(excluded.sorted.len())
+        .map_err(|_| Error::LimitExceeded {
+            resource: "ordered projection excluded block ids",
+            limit: excluded.sorted.len(),
+        })?;
+    for (index, feature) in features.iter().enumerate() {
+        if excluded.contains(index) {
+            excluded_ids.push(feature.block);
+        } else {
+            projected.push(feature.clone());
+        }
+    }
+    if projected.len() != retained_count || excluded_ids.len() != excluded.sorted.len() {
+        return Err(Error::Unresolved(format!(
+            "{side} ordered projection retained an unexpected block count"
+        )));
+    }
+    Ok((projected, excluded_ids))
+}
+
+fn remap_boundaries(
+    boundaries: &[usize],
+    excluded: &ExcludedIndices,
+    resource: &'static str,
+) -> Result<Vec<usize>> {
+    let mut remapped = Vec::new();
+    remapped
+        .try_reserve_exact(boundaries.len())
+        .map_err(|_| Error::LimitExceeded {
+            resource,
+            limit: boundaries.len(),
+        })?;
+    remapped.extend(
+        boundaries
+            .iter()
+            .map(|&boundary| excluded.remap_boundary(boundary)),
+    );
+    remapped.sort_unstable();
+    remapped.dedup();
+    Ok(remapped)
+}
+
+fn remap_extraction_uncertain_indices(
+    indices: &[usize],
+    excluded: &ExcludedIndices,
+    resource: &'static str,
+) -> Result<(Vec<usize>, Vec<usize>)> {
+    let mut remapped = Vec::new();
+    remapped
+        .try_reserve_exact(indices.len())
+        .map_err(|_| Error::LimitExceeded {
+            resource,
+            limit: indices.len(),
+        })?;
+    let mut boundaries = Vec::new();
+    boundaries
+        .try_reserve_exact(indices.len())
+        .map_err(|_| Error::LimitExceeded {
+            resource,
+            limit: indices.len(),
+        })?;
+    for &index in indices {
+        if excluded.contains(index) {
+            boundaries.push(excluded.remap_boundary(index));
+        } else {
+            remapped.push(excluded.remap_index(index));
+        }
+    }
+    remapped.sort_unstable();
+    remapped.dedup();
+    boundaries.sort_unstable();
+    boundaries.dedup();
+    Ok((remapped, boundaries))
+}
+
+fn remap_retained_indices(
+    indices: &[usize],
+    excluded: &ExcludedIndices,
+    resource: &'static str,
+) -> Result<Vec<usize>> {
+    let mut remapped = Vec::new();
+    remapped
+        .try_reserve_exact(indices.len())
+        .map_err(|_| Error::LimitExceeded {
+            resource,
+            limit: indices.len(),
+        })?;
+    for &index in indices {
+        if !excluded.contains(index) {
+            remapped.push(excluded.remap_index(index));
+        }
+    }
+    remapped.sort_unstable();
+    remapped.dedup();
+    Ok(remapped)
+}
+
+fn merge_boundaries(
+    mut left: Vec<usize>,
+    right: Vec<usize>,
+    resource: &'static str,
+) -> Result<Vec<usize>> {
+    left.try_reserve(right.len())
+        .map_err(|_| Error::LimitExceeded {
+            resource,
+            limit: left.len().saturating_add(right.len()),
+        })?;
+    left.extend(right);
+    left.sort_unstable();
+    left.dedup();
+    Ok(left)
+}
