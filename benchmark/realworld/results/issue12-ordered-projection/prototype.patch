+            id: region.id,
+            page: region.page,
+            bbox,
+            line_ids: chunk.to_vec(),
+        };
+        if !region_lines_are_monotone(&segment, lines) {
+            return None;
+        }
+        runs.push(TrustedLineRun {
+            line_ids: segment.line_ids,
+        });
+        previous_bbox = Some(bbox);
+    }
