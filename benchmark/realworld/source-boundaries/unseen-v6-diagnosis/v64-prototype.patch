+    fn endpoint_bounds(&self, node: &GraphNode) -> Option<(PageId, Rect, [u32; 2])> {
+        let [page] = node.pages.as_slice() else {
+            return None;
+        };
+        let glyph = |source: &SourceRef| {
+            let SourceRef::Native { glyph } = source else {
+                return None;
+            };
+            self.glyphs.get(glyph).copied()
+        };
+        let first = glyph(node.sources.first()?)?;
+        let last = glyph(node.sources.last()?)?;
+        if [first, last]
+            .iter()
+            .any(|glyph| glyph.page != *page || glyph.direction != (Vec2 { x: 1.0, y: 0.0 }))
+        {
+            return None;
+        }
+        Some((
+            *page,
+            Rect {
+                min: Vec2 {
+                    x: first.bbox.min.x.min(last.bbox.min.x),
+                    y: first.bbox.min.y.min(last.bbox.min.y),
+                },
+                max: Vec2 {
+                    x: first.bbox.max.x.max(last.bbox.max.x),
+                    y: first.bbox.max.y.max(last.bbox.max.y),
+                },
+            },
+            [first.render_order, last.render_order],
+        ))
+    }
