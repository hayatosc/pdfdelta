+        let mut glyphs = fixture.0.native.items().to_vec();
+        for glyph in &mut glyphs {
+            if side.contains(&SourceRef::Native { glyph: glyph.id }) {
+                glyph.baseline.x += 1000.0;
+                glyph.bbox.min.x += 1000.0;
