+/// A union of complete subpath envelopes contains the same painted effect.
+/// Every component must have finite bounds. Unknown arithmetic, device-dependent
+/// strokes or incomplete component acquisition retain the whole-path fallback.
+pub(super) fn path_paint_components(
+    frame: PageGeometry,
+    state: &InterpreterState,
+    stroke: bool,
+) -> Option<Vec<Rect>> {
+    let path = &state.current_path;
+    path.paint_bounds
+        .components(path.drawn_subpaths)?
+        .into_iter()
+        .map(|bounds| expand_path_bounds(frame, state, stroke, bounds))
+        .collect()
+}
