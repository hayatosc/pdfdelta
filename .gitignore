/target
/fuzz/target
/fuzz/artifacts

# Python benchmark helpers generate bytecode caches locally.
__pycache__/
*.pyc
*.pyo

# libFuzzer writes coverage-increasing units back into the corpus directory.
# Only curated, format-specific seeds are tracked; generated units are regenerable.
/fuzz/corpus/*/*
!/fuzz/corpus/*/*.pdf
!/fuzz/corpus/*/*.cmap
!/fuzz/corpus/*/*.content
!/fuzz/corpus/font_decoder/*.bin
!/fuzz/corpus/canonical_yaml/*.yaml

# Downloaded real-world benchmark documents are never vendored.
benchmark/realworld/cache/

# Keep evaluation documents, measurements, and cited validation evidence.
# Omit uncited raw execution logs and new temporary captures.
benchmark/realworld/results/**/*.log
